{
  "name": "blog-app-backend",
  "version": "1.0.0",
  "description": "Blog App REST API built with Express, Prisma, PostgreSQL, and TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
